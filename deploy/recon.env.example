# /etc/recon/recon.env: the server's production settings, read by systemd
# (deploy/recon-server.service, EnvironmentFile=). Mode 0640, owner root:recon: it holds
# the database password and the operator token. Every value is checked at startup; a
# wrong one stops the server with exit status 78 and says which (journalctl -u recon-server).

# The runtime role's connection (recon_app; never the owner or the administrator).
# Keep TLS on: sslmode=verify-full with a hosted database, require at least.
RECON_DATABASE_URL=postgres://recon_app:CHANGE-ME@127.0.0.1:5432/recon?sslmode=require

# The operator token every /v1 request sends as `Authorization: Bearer ...` until sign-in
# arrives (R3). At least 32 printable characters: `openssl rand -hex 32`.
RECON_OPERATOR_TOKEN=CHANGE-ME-generate-with-openssl-rand-hex-32

# Loopback only: the reverse proxy (deploy/Caddyfile) terminates TLS in front.
RECON_LISTEN=127.0.0.1:62480

# Logs go to stderr (the journal). JSON for a log collector; ids, codes and counts only,
# never file content, file names or tokens.
RECON_LOG=info
RECON_LOG_FORMAT=json

# Capacity. Imports beyond the concurrency are refused with 503 import_capacity, never
# queued; size the database pool above it.
RECON_IMPORT_CONCURRENCY=4
RECON_DB_MAX_CONNECTIONS=32
# Parsed rows all uploads together may hold before they are stored (MiB).
RECON_STAGING_BUDGET_MIB=64

# Bounds, in milliseconds, with their defaults (uncomment to change; ranges are checked).
#RECON_PARSE_DEADLINE_MS=60000
#RECON_BODY_IDLE_MS=15000
#RECON_REQUEST_TIMEOUT_MS=150000
#RECON_FLIP_TIMEOUT_MS=60000
#RECON_STATEMENT_TIMEOUT_MS=10000
#RECON_DB_ACQUIRE_MS=1500
#RECON_IMPORT_LEASE_MS=30000
#RECON_SWEEP_INTERVAL_MS=10000
#RECON_DRAIN_MS=30000
#RECON_HEADER_READ_TIMEOUT_MS=10000
#RECON_WRITE_STALL_MS=10000
#RECON_CONNECTION_MAX_AGE_MS=300000
#RECON_MAX_CONNECTIONS=512
#RECON_MAX_IN_FLIGHT=256
#RECON_MAX_REQUESTS_PER_CONNECTION=1000
